# Set this to the final HTTPS production URL before deploying, without a trailing slash.
# Example: NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SITE_URL=

# Payload CMS and PostgreSQL. Use a strong, unique secret (at least 32 random bytes).
PAYLOAD_SECRET=
DATABASE_URI=postgres://user:password@localhost:5432/portfolio

# Optional S3-compatible persistent media storage (AWS S3, Cloudflare R2, etc.).
# When S3_BUCKET is empty, Payload stores uploads locally for development.
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# For S3-compatible providers such as Cloudflare R2; omit for AWS S3.
S3_ENDPOINT=
